---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import resume from '../data/resume.json';
import { formatDate, inferEndDates } from '../lib/date';
import { isEducationTag, isExperienceTag } from '../lib/history-tags';

const isUrl = (value?: string) => !!value && /^https?:\/\//.test(value);

// A multi-line Description in the CMS becomes bullet points (one per
// non-empty line) — a single line still reads as a plain sentence.
const toLines = (text: string) => text.split('\n').map((line) => line.trim()).filter(Boolean);

const historyEntries = (await getCollection('history')).map((entry) => entry.data);

const experienceEntries = historyEntries.filter((entry) => isExperienceTag(entry.tag));
const experienceEnds = inferEndDates(experienceEntries, 'Present');
const experience = [...experienceEntries].sort((a, b) => b.date.localeCompare(a.date));
const education = historyEntries
  .filter((entry) => isEducationTag(entry.tag))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Resume" description={`${resume.name} — Resume / CV`}>
  <!-- This is the on-site viewer, styled to match the rest of the site.
       The downloadable PDF is a deliberately different, separate document
       (src/pages/cv/[lang].astro + src/components/CvDocument.astro) built
       to read as a traditional professional CV rather than a dark-themed
       printout of this page. -->
  <article class="mx-auto max-w-3xl px-6 pb-20 pt-32 sm:pt-36">
    <div class="flex flex-col gap-6 border-b border-border pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-accent-2">Curriculum Vitae</p>
        <h1 class="mt-2 font-display text-4xl font-extrabold text-paper">{resume.name}</h1>
        <p class="mt-1 text-lg font-semibold text-paper-dim">{resume.role}</p>
      </div>
      <div class="flex w-fit shrink-0 flex-col gap-2 sm:items-end">
        <a
          href={resume.customCvEn || '/cv/resume-en.pdf'}
          download
          class="inline-flex items-center gap-2 rounded-none bg-accent px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink-950 transition-all hover:-translate-y-0.5 hover:bg-accent-2"
        >
          Download PDF (English)
        </a>
        <a
          href={resume.customCvId || '/cv/resume-id.pdf'}
          download
          class="inline-flex items-center gap-2 rounded-none bg-accent px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink-950 transition-all hover:-translate-y-0.5 hover:bg-accent-2"
        >
          Unduh PDF (Bahasa Indonesia)
        </a>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-paper-dim">
      {resume.location && <span>{resume.location}</span>}
      <a href={`mailto:${resume.email}`} class="hover:text-accent-2">{resume.email}</a>
      {isUrl(resume.artstationUrl) && (
        <a href={resume.artstationUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">ArtStation</a>
      )}
      {isUrl(resume.githubUrl) && (
        <a href={resume.githubUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">GitHub</a>
      )}
      {isUrl(resume.youtubeUrl) && (
        <a href={resume.youtubeUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">YouTube</a>
      )}
      {isUrl(resume.xUrl) && (
        <a href={resume.xUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">X</a>
      )}
      {isUrl(resume.instagramUrl) && (
        <a href={resume.instagramUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">Instagram</a>
      )}
      {isUrl(resume.linkedinUrl) && (
        <a href={resume.linkedinUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">LinkedIn</a>
      )}
    </div>

    <p class="mt-6 max-w-2xl text-paper-dim">{resume.cvSummary || resume.tagline}</p>

    <section class="mt-10">
      <h2 class="font-display text-xl font-bold text-paper">Skills</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-3">
        {resume.skills.map((group) => (
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-accent-2">{group.category}</p>
            <ul class="mt-2 space-y-1 text-sm text-paper-dim">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="font-display text-xl font-bold text-paper">Professional Experience</h2>
      <p class="mt-1 text-xs text-paper-dim">Pulled from the site's career timeline (tagged "job", "current", or "release") — edit entries there to update this section.</p>
      <ol class="mt-4 space-y-6 border-l border-border pl-6">
        {experience.map((entry) => {
          const lines = toLines(entry.description);
          return (
            <li class="relative">
              <span class="absolute -left-[27px] mt-1.5 h-2.5 w-2.5 rounded-none bg-accent" />
              <p class="text-xs font-bold uppercase tracking-wide text-accent-2">
                {formatDate(entry.date)} &ndash; {experienceEnds.get(entry)}
              </p>
              <h3 class="mt-1 font-display font-semibold text-paper">
                {entry.title}
                {entry.organization && <span class="font-normal text-paper-dim"> &middot; {entry.organization}</span>}
              </h3>
              {lines.length > 1 ? (
                <ul class="mt-1 list-disc space-y-0.5 pl-4 text-sm text-paper-dim">
                  {lines.map((line) => <li>{line}</li>)}
                </ul>
              ) : (
                <p class="mt-1 text-sm text-paper-dim">{entry.description}</p>
              )}
            </li>
          );
        })}
      </ol>
    </section>

    {education.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-xl font-bold text-paper">Education</h2>
        <ol class="mt-4 space-y-6 border-l border-border pl-6">
          {education.map((entry) => (
            <li class="relative">
              <span class="absolute -left-[27px] mt-1.5 h-2.5 w-2.5 rounded-none bg-accent" />
              <p class="text-xs font-bold uppercase tracking-wide text-accent-2">{formatDate(entry.date)}</p>
              <h3 class="mt-1 font-display font-semibold text-paper">
                {entry.title}
                {entry.organization && <span class="font-normal text-paper-dim"> &middot; {entry.organization}</span>}
              </h3>
              <p class="mt-1 text-sm text-paper-dim">{entry.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Layout>
