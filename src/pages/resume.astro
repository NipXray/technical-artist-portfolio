---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import resume from '../data/resume.json';
import { formatDate } from '../lib/date';

const isUrl = (value?: string) => !!value && /^https?:\/\//.test(value);

const historyEntries = (await getCollection('history'))
  .map((entry) => entry.data)
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Resume" description={`${resume.name} — Resume / CV`}>
  <article class="mx-auto max-w-3xl px-6 pb-20 pt-32 sm:pt-36">
    <div class="flex flex-col gap-6 border-b border-border pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-accent-2">Curriculum Vitae</p>
        <h1 class="mt-2 font-display text-4xl font-extrabold text-paper">{resume.name}</h1>
        <p class="mt-3 max-w-lg text-paper-dim">{resume.tagline}</p>
      </div>
      <a
        href={resume.cvUrl}
        download
        class="inline-flex w-fit shrink-0 items-center gap-2 rounded-none bg-accent px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink-950 transition-all hover:-translate-y-0.5 hover:bg-accent-2"
      >
        Download PDF
      </a>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-paper-dim">
      <a href={`mailto:${resume.email}`} class="hover:text-accent-2">{resume.email}</a>
      {isUrl(resume.artstationUrl) && (
        <a href={resume.artstationUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">ArtStation</a>
      )}
      {isUrl(resume.githubUrl) && (
        <a href={resume.githubUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">GitHub</a>
      )}
      {isUrl(resume.youtubeUrl) && (
        <a href={resume.youtubeUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">YouTube</a>
      )}
      {isUrl(resume.xUrl) && (
        <a href={resume.xUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">X</a>
      )}
      {isUrl(resume.instagramUrl) && (
        <a href={resume.instagramUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">Instagram</a>
      )}
      {isUrl(resume.linkedinUrl) && (
        <a href={resume.linkedinUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2">LinkedIn</a>
      )}
    </div>

    <section class="mt-12">
      <h2 class="font-display text-xl font-bold text-paper">Skills</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-3">
        {resume.skills.map((group) => (
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-accent-2">{group.category}</p>
            <ul class="mt-2 space-y-1 text-sm text-paper-dim">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-xl font-bold text-paper">Experience</h2>
      <p class="mt-1 text-xs text-paper-dim">Pulled from the site's career timeline — edit entries there to update this section.</p>
      <ol class="mt-4 space-y-6 border-l border-border pl-6">
        {historyEntries.map((entry) => (
          <li class="relative">
            <span class="absolute -left-[27px] mt-1.5 h-2.5 w-2.5 rounded-none bg-accent" />
            <p class="text-xs font-bold uppercase tracking-wide text-accent-2">{formatDate(entry.date)}</p>
            <h3 class="mt-1 font-display font-semibold text-paper">{entry.title}</h3>
            <p class="mt-1 text-sm text-paper-dim">{entry.description}</p>
          </li>
        ))}
      </ol>
    </section>
  </article>
</Layout>
