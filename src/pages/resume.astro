---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import resume from '../data/resume.json';
import { formatDate } from '../lib/date';

const isUrl = (value?: string) => !!value && /^https?:\/\//.test(value);

// A multi-line Description in the CMS becomes bullet points (one per
// non-empty line) — a single line still reads as a plain sentence.
const toLines = (text: string) => text.split('\n').map((line) => line.trim()).filter(Boolean);

const historyEntries = (await getCollection('history')).map((entry) => entry.data);

// "origin" entries are personal milestones meant for the on-site career
// timeline, not a formal document — everything else (job/current/release)
// reads as real professional experience; "education" gets its own section.
const experience = historyEntries
  .filter((entry) => entry.tag !== 'origin' && entry.tag !== 'education')
  .sort((a, b) => b.date.localeCompare(a.date));
const education = historyEntries
  .filter((entry) => entry.tag === 'education')
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Resume" description={`${resume.name} — Resume / CV`}>
  <!-- Printed/exported as the downloadable CV PDF (see scripts/generate-resume-pdf.mjs),
       so everything below also carries a print: variant swapping the dark
       on-site theme for plain black-on-white — a print-friendly document,
       not a screenshot of the dark site. -->
  <article class="mx-auto max-w-3xl px-6 pb-20 pt-32 sm:pt-36 print:max-w-none print:px-0 print:pb-0 print:pt-0">
    <div class="flex flex-col gap-6 border-b border-border pb-8 sm:flex-row sm:items-end sm:justify-between print:border-neutral-300 print:pb-3">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-accent-2 print:text-neutral-500">Curriculum Vitae</p>
        <h1 class="mt-2 font-display text-4xl font-extrabold text-paper print:text-black">{resume.name}</h1>
        <p class="mt-1 text-lg font-semibold text-paper-dim print:text-neutral-700">{resume.role}</p>
      </div>
      <a
        href={resume.cvUrl}
        download
        class="inline-flex w-fit shrink-0 items-center gap-2 rounded-none bg-accent px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink-950 transition-all hover:-translate-y-0.5 hover:bg-accent-2 print:hidden"
      >
        Download PDF
      </a>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-paper-dim print:text-neutral-700">
      {resume.location && <span>{resume.location}</span>}
      <a href={`mailto:${resume.email}`} class="hover:text-accent-2 print:text-neutral-700">{resume.email}</a>
      {isUrl(resume.artstationUrl) && (
        <a href={resume.artstationUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2 print:text-neutral-700">ArtStation</a>
      )}
      {isUrl(resume.githubUrl) && (
        <a href={resume.githubUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2 print:text-neutral-700">GitHub</a>
      )}
      {isUrl(resume.youtubeUrl) && (
        <a href={resume.youtubeUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2 print:text-neutral-700">YouTube</a>
      )}
      {isUrl(resume.xUrl) && (
        <a href={resume.xUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2 print:text-neutral-700">X</a>
      )}
      {isUrl(resume.instagramUrl) && (
        <a href={resume.instagramUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2 print:text-neutral-700">Instagram</a>
      )}
      {isUrl(resume.linkedinUrl) && (
        <a href={resume.linkedinUrl} target="_blank" rel="noreferrer" class="hover:text-accent-2 print:text-neutral-700">LinkedIn</a>
      )}
    </div>

    <p class="mt-6 max-w-2xl text-paper-dim print:text-neutral-700">{resume.cvSummary || resume.tagline}</p>

    <section class="mt-10 print:mt-5">
      <h2 class="font-display text-xl font-bold text-paper print:text-black">Skills</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-3 print:grid-cols-3 print:gap-4">
        {resume.skills.map((group) => (
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-accent-2 print:text-neutral-500">{group.category}</p>
            <ul class="mt-2 space-y-1 text-sm text-paper-dim print:text-neutral-700">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 print:mt-5">
      <h2 class="font-display text-xl font-bold text-paper print:text-black">Professional Experience</h2>
      <p class="mt-1 text-xs text-paper-dim print:hidden">Pulled from the site's career timeline (tagged "job", "current", or "release") — edit entries there to update this section.</p>
      <ol class="mt-4 space-y-6 border-l border-border pl-6 print:mt-2 print:space-y-3 print:border-neutral-300">
        {experience.map((entry) => {
          const lines = toLines(entry.description);
          return (
            <li class="relative">
              <span class="absolute -left-[27px] mt-1.5 h-2.5 w-2.5 rounded-none bg-accent print:bg-black" />
              <p class="text-xs font-bold uppercase tracking-wide text-accent-2 print:text-neutral-500">{formatDate(entry.date)}</p>
              <h3 class="mt-1 font-display font-semibold text-paper print:text-black">
                {entry.title}
                {entry.organization && <span class="font-normal text-paper-dim print:text-neutral-700"> &middot; {entry.organization}</span>}
              </h3>
              {lines.length > 1 ? (
                <ul class="mt-1 list-disc space-y-0.5 pl-4 text-sm text-paper-dim print:text-neutral-700">
                  {lines.map((line) => <li>{line}</li>)}
                </ul>
              ) : (
                <p class="mt-1 text-sm text-paper-dim print:text-neutral-700">{entry.description}</p>
              )}
            </li>
          );
        })}
      </ol>
    </section>

    {education.length > 0 && (
      <section class="mt-10 print:mt-5">
        <h2 class="font-display text-xl font-bold text-paper print:text-black">Education</h2>
        <ol class="mt-4 space-y-6 border-l border-border pl-6 print:mt-2 print:space-y-3 print:border-neutral-300">
          {education.map((entry) => (
            <li class="relative">
              <span class="absolute -left-[27px] mt-1.5 h-2.5 w-2.5 rounded-none bg-accent print:bg-black" />
              <p class="text-xs font-bold uppercase tracking-wide text-accent-2 print:text-neutral-500">{formatDate(entry.date)}</p>
              <h3 class="mt-1 font-display font-semibold text-paper print:text-black">
                {entry.title}
                {entry.organization && <span class="font-normal text-paper-dim print:text-neutral-700"> &middot; {entry.organization}</span>}
              </h3>
              <p class="mt-1 text-sm text-paper-dim print:text-neutral-700">{entry.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Layout>
