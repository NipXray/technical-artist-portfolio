---
import '../styles/global.css';
import { CV_LABELS, type CvLang } from '../lib/cv-translations';

interface ExperienceItem {
  title: string;
  organization?: string;
  dateLabel: string;
  bullets: string[];
}

interface Props {
  lang: CvLang;
  name: string;
  role: string;
  location?: string;
  email: string;
  phone?: string;
  githubUrl?: string;
  artstationUrl?: string;
  linkedinUrl?: string;
  summary: string;
  skills: { category: string; items: string[] }[];
  experience: ExperienceItem[];
  education: ExperienceItem[];
}

const {
  lang,
  name,
  role,
  location,
  email,
  phone,
  githubUrl,
  artstationUrl,
  linkedinUrl,
  summary,
  skills,
  experience,
  education
} = Astro.props;

const t = CV_LABELS[lang];
const isUrl = (value?: string) => !!value && /^https?:\/\//.test(value);
const contactLine = [location, email, phone].filter(Boolean).join(' | ');
const linkLine = [
  isUrl(artstationUrl) && `ArtStation: ${artstationUrl!.replace(/^https?:\/\//, '')}`,
  isUrl(githubUrl) && `GitHub: ${githubUrl!.replace(/^https?:\/\//, '')}`,
  isUrl(linkedinUrl) && `LinkedIn: ${linkedinUrl!.replace(/^https?:\/\//, '')}`
]
  .filter(Boolean)
  .join(' | ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{t.documentTitle} — {name}</title>
  </head>
  <body class="bg-white font-sans text-slate-700">
    <header class="bg-slate-800 px-10 py-10 text-center text-white">
      <h1 class="font-sans text-3xl font-bold uppercase tracking-wide">{name}</h1>
      <p class="mt-3 text-sm text-slate-300">{contactLine}</p>
      {linkLine && <p class="mt-1 text-sm text-slate-300">{linkLine}</p>}
    </header>

    <main class="mx-auto max-w-3xl px-10 py-10">
      <section>
        <h2 class="border-b-2 border-slate-800 pb-1 text-sm font-bold uppercase tracking-wide text-slate-800">
          {t.professionalSummary}
        </h2>
        <p class="mt-3 text-sm leading-relaxed">
          <span class="font-semibold">{role}.</span> {summary}
        </p>
      </section>

      <section class="mt-8">
        <h2 class="border-b-2 border-slate-800 pb-1 text-sm font-bold uppercase tracking-wide text-slate-800">
          {t.skills}
        </h2>
        <div class="mt-3 space-y-1.5 text-sm">
          {skills.map((group) => (
            <div class="flex flex-col sm:flex-row sm:gap-4">
              <p class="shrink-0 font-bold text-sky-700 sm:w-40">{group.category}</p>
              <p>{group.items.join(', ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-8">
        <h2 class="border-b-2 border-slate-800 pb-1 text-sm font-bold uppercase tracking-wide text-slate-800">
          {t.experience}
        </h2>
        <div class="mt-4 space-y-5">
          {experience.map((item) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-bold text-slate-800">{item.title}</h3>
                <p class="text-sm italic text-slate-500">{item.dateLabel}</p>
              </div>
              {item.organization && <p class="text-sm italic text-slate-500">{item.organization}</p>}
              <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm">
                {item.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      {education.length > 0 && (
        <section class="mt-8">
          <h2 class="border-b-2 border-slate-800 pb-1 text-sm font-bold uppercase tracking-wide text-slate-800">
            {t.education}
          </h2>
          <div class="mt-4 space-y-5">
            {education.map((item) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="font-bold text-slate-800">{item.title}</h3>
                  <p class="text-sm italic text-slate-500">{item.dateLabel}</p>
                </div>
                {item.organization && <p class="text-sm italic text-slate-500">{item.organization}</p>}
                {item.bullets.length > 0 && (
                  <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm">
                    {item.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </main>
  </body>
</html>
