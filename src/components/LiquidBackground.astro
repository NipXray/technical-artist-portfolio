---
// Persistent whole-site background layer: a black outer field with an
// organic grey "inner layer" bleeding through, split by a liquid-looking
// boundary. Pure SVG + SMIL/CSS (no JS animation loop) since this sits
// behind every page and animates continuously — a requestAnimationFrame
// loop here would burn a frame budget for a purely decorative layer.
---

<div class="liquid-bg pointer-events-none fixed inset-0 -z-10 overflow-hidden print:hidden" aria-hidden="true">
  <svg class="h-full w-full" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
    <defs>
      <filter id="liquid-distort-a" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.010 0.014" numOctaves="2" seed="7" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="34s"
            values="0.010 0.014;0.014 0.009;0.009 0.016;0.010 0.014"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <!-- Displacement only, no blur — the wavy edge stays a crisp, clearly
             legible cut. Volume comes from the fill's own shading below, not
             from softening the silhouette into a haze. -->
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="55" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="liquid-distort-b" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.014 0.018" numOctaves="2" seed="23" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="26s"
            values="0.014 0.018;0.018 0.012;0.012 0.02;0.014 0.018"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Fully opaque at every stop — only the color shifts, from a lighter
           grey where light would catch a solid blob to a darker grey at the
           rim. That's what reads as a lit, shaded volume without ever
           fading the silhouette itself into fog. -->
      <radialGradient id="liquid-grad-a" cx="34%" cy="38%" r="78%">
        <stop offset="0%" stop-color="var(--color-ink-600)" />
        <stop offset="45%" stop-color="var(--color-ink-700)" />
        <stop offset="100%" stop-color="var(--color-ink-900)" />
      </radialGradient>
      <radialGradient id="liquid-grad-b" cx="38%" cy="34%" r="72%">
        <stop offset="0%" stop-color="#454545" />
        <stop offset="45%" stop-color="var(--color-ink-600)" />
        <stop offset="100%" stop-color="var(--color-ink-800)" />
      </radialGradient>
    </defs>

    <!-- Back layer: darker grey, larger, slower drift -->
    <g class="liquid-layer liquid-layer-a" filter="url(#liquid-distort-a)">
      <path
        fill="url(#liquid-grad-a)"
        d="M -100,-100 C 120,-40 260,120 220,320 C 180,510 340,560 320,760 C 305,900 140,970 -100,940 Z"
      ></path>
    </g>

    <!-- Front layer: lighter grey, smaller, faster drift, offset for depth -->
    <g class="liquid-layer liquid-layer-b" filter="url(#liquid-distort-b)">
      <path
        fill="url(#liquid-grad-b)"
        d="M -100,60 C 60,10 190,140 170,320 C 150,480 260,540 230,700 C 210,820 90,860 -100,800 Z"
      ></path>
    </g>
  </svg>
</div>

<script is:inline>
  (function () {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.liquid-bg svg').forEach((svg) => svg.pauseAnimations && svg.pauseAnimations());
  })();
</script>
