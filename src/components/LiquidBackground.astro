---
// Persistent whole-site background layer: a solid grey backdrop with a
// wavy black shape drifting on top of it, like the black is a moving
// surface layer sitting over a plain grey base. The ambient drift/wobble
// is pure SVG + SMIL/CSS (no JS animation loop) since it runs continuously
// behind every page.
//
// On top of that, the wave and every bubble also react to the cursor:
// moving the mouse near one locally agitates its own ambient turbulence,
// like a finger dragged through oil, which then settles back to rest once
// the cursor stops. This part genuinely needs live pointer input, so it's
// JS-driven — via feImage.href pointed at a generated data-URI (not a
// same-document element reference: feImage referencing a live local
// element by fragment ID turned out to render inconsistently in testing,
// producing no visible effect despite the DOM wiring being correct: a
// data-URI is loaded as a real image resource, which is the reliable path
// browsers actually support well). The regeneration loop only runs via
// requestAnimationFrame while the effect is actively playing (movement +
// its short decay tail), then stops — not a persistent idle loop.
---

<div class="liquid-bg pointer-events-none fixed inset-0 -z-10 overflow-hidden print:hidden" aria-hidden="true">
  <svg class="h-full w-full" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
    <defs>
      <filter id="liquid-distort-a" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
        <!-- numOctaves=1 rather than 2: fractalNoise's second octave is
             genuinely high-frequency per-pixel detail, and displacing by
             raw high-frequency noise is what reads as speckled/jagged. One
             octave keeps the same organic large-scale wobble with none of
             that fine texture, so the edge is crisp with no grain and no
             blur needed at all. -->
        <feTurbulence type="fractalNoise" baseFrequency="0.014 0.0125" numOctaves="1" seed="7" result="noise">
          <!-- A true sinusoid sampled at 12 evenly-spaced points, not a
               handful of hand-picked values — equal time between values
               here doesn't mean equal PERCEIVED change unless the values
               trace a smooth curve, or the wobble visibly pauses/bursts. -->
          <animate
            attributeName="baseFrequency"
            dur="68s"
            values="0.0140 0.0125;0.0137 0.0143;0.0128 0.0155;0.0115 0.0160;0.0103 0.0155;0.0093 0.0143;0.0090 0.0125;0.0093 0.0108;0.0103 0.0095;0.0115 0.0090;0.0128 0.0095;0.0137 0.0108;0.0140 0.0125"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="46" xChannelSelector="R" yChannelSelector="G" result="ambient" />
        <!-- Interactive stage: blend the same ambient noise toward neutral
             (0.5 = no displacement) everywhere except near the cursor,
             using a JS-updated blurred-circle image as the blend strength.
             Reusing the ambient noise (rather than a separate generator)
             means the push still reads as the same "material" as the rest
             of the wave, just locally agitated — like a finger dragged
             through it — instead of a foreign ripple pattern. -->
        <feImage class="liquid-smear-feimage" x="-600" y="-600" width="2200" height="2200" result="smearMask" preserveAspectRatio="none" />
        <feComposite in="noise" in2="smearMask" operator="arithmetic" k1="1" k2="0" k3="-0.5" k4="0.5" result="localNoise" />
        <feDisplacementMap in="ambient" in2="localNoise" scale="70" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Bubble edges get the same treatment at a smaller scale: a genuine
           wobbling silhouette (not a rigid circle) via turbulence
           displacement, sharp — no blur — with a much higher baseFrequency
           and smaller displacement scale so the wobble fits a ~70-90 unit
           circle instead of the ~1000-unit main shape. Four distinct
           seeds/rates so the bubbles don't wobble in lockstep, and each
           also gets the same cursor-reactive push as the wave. -->
      <filter id="liquid-bubble-distort-a" x="-70%" y="-70%" width="240%" height="240%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" seed="11" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="60s"
            values="0.062;0.0585;0.050;0.0415;0.038;0.0415;0.050;0.0585;0.062"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" result="ambient" />
        <feImage class="liquid-smear-feimage" x="-600" y="-600" width="2200" height="2200" result="smearMask" preserveAspectRatio="none" />
        <feComposite in="noise" in2="smearMask" operator="arithmetic" k1="1" k2="0" k3="-0.5" k4="0.5" result="localNoise" />
        <feDisplacementMap in="ambient" in2="localNoise" scale="26" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="liquid-bubble-distort-b" x="-70%" y="-70%" width="240%" height="240%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.065" numOctaves="1" seed="31" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="48s"
            values="0.079;0.0749;0.065;0.0551;0.051;0.0551;0.065;0.0749;0.079"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" result="ambient" />
        <feImage class="liquid-smear-feimage" x="-600" y="-600" width="2200" height="2200" result="smearMask" preserveAspectRatio="none" />
        <feComposite in="noise" in2="smearMask" operator="arithmetic" k1="1" k2="0" k3="-0.5" k4="0.5" result="localNoise" />
        <feDisplacementMap in="ambient" in2="localNoise" scale="26" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="liquid-bubble-distort-c" x="-70%" y="-70%" width="240%" height="240%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.058" numOctaves="1" seed="51" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="72s"
            values="0.069;0.0658;0.058;0.0502;0.047;0.0502;0.058;0.0658;0.069"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" result="ambient" />
        <feImage class="liquid-smear-feimage" x="-600" y="-600" width="2200" height="2200" result="smearMask" preserveAspectRatio="none" />
        <feComposite in="noise" in2="smearMask" operator="arithmetic" k1="1" k2="0" k3="-0.5" k4="0.5" result="localNoise" />
        <feDisplacementMap in="ambient" in2="localNoise" scale="26" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="liquid-bubble-distort-d" x="-70%" y="-70%" width="240%" height="240%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.062" numOctaves="1" seed="67" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="54s"
            values="0.073;0.0693;0.062;0.0533;0.049;0.0533;0.062;0.0693;0.073"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" result="ambient" />
        <feImage class="liquid-smear-feimage" x="-600" y="-600" width="2200" height="2200" result="smearMask" preserveAspectRatio="none" />
        <feComposite in="noise" in2="smearMask" operator="arithmetic" k1="1" k2="0" k3="-0.5" k4="0.5" result="localNoise" />
        <feDisplacementMap in="ambient" in2="localNoise" scale="26" xChannelSelector="R" yChannelSelector="G" />
      </filter>

      <!-- Turbulence/displacement distorts only a plain white silhouette
           here, used purely as a mask — not the black fill itself. -->
      <mask id="liquid-mask-a" maskUnits="userSpaceOnUse" x="-600" y="-600" width="2200" height="2200">
        <g filter="url(#liquid-distort-a)">
          <path
            fill="#fff"
            d="M -100,-100 C 120,-40 260,120 220,320 C 210,480 300,600 320,760 C 305,900 140,970 -100,940 Z"
          ></path>
        </g>
      </mask>
    </defs>

    <!-- Solid grey base — no mask, no filter, no animation. Just the flat
         backdrop color everywhere; the wave lives entirely in the black
         shape drawn on top of it. -->
    <rect x="0" y="0" width="1000" height="1000" fill="var(--color-ink-700)"></rect>

    <!-- The one wavy shape: solid black, drifting/wobbling on top of the
         grey base. -->
    <g class="liquid-layer liquid-layer-a">
      <rect x="-600" y="-600" width="2200" height="2200" fill="var(--color-ink-950)" mask="url(#liquid-mask-a)"></rect>
    </g>

    <!-- Three dark "bubbles" drifting/pulsing on the flat grey side, clear
         of the black wave shape's own footprint (which sits on the left of
         the viewBox). Spread diagonally across the grey area's full width
         and height rather than clustered together, so they read as
         scattered rather than as one clumped group. -->
    <circle class="liquid-bubble liquid-bubble-1" filter="url(#liquid-bubble-distort-a)" cx="470" cy="330" r="38" fill="var(--color-ink-950)"></circle>
    <circle class="liquid-bubble liquid-bubble-2" filter="url(#liquid-bubble-distort-b)" cx="830" cy="520" r="44" fill="var(--color-ink-950)"></circle>
    <circle class="liquid-bubble liquid-bubble-3" filter="url(#liquid-bubble-distort-c)" cx="620" cy="800" r="30" fill="var(--color-ink-950)"></circle>
    <circle class="liquid-bubble liquid-bubble-4" filter="url(#liquid-bubble-distort-d)" cx="500" cy="600" r="34" fill="var(--color-ink-950)"></circle>
  </svg>
</div>

<script is:inline>
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var svgEl = document.querySelector('.liquid-bg svg');
    var feImages = document.querySelectorAll('.liquid-smear-feimage');
    if (reduceMotion) {
      document.querySelectorAll('.liquid-bg svg').forEach((svg) => svg.pauseAnimations && svg.pauseAnimations());
    }
    if (reduceMotion || !svgEl || !feImages.length) return;

    var pt = svgEl.createSVGPoint();
    var targetX = 500;
    var targetY = 500;
    var intensity = 0;
    var lastMoveTime = 0;
    var rafId = null;
    var lastTickTime = 0;
    var DECAY_MS = 1800;
    var HOLD_MS = 60;
    // Setting href on a feImage re-runs that shape's ENTIRE filter chain
    // (feTurbulence + two feDisplacementMap passes) — by far the most
    // expensive part of this effect. Two independent cuts on that cost:
    // throttle how often it happens at all (a slow liquid push doesn't
    // need 60fps), and only touch shapes the cursor is actually near
    // instead of re-triggering all 5 filter chains on every single frame
    // regardless of whether the cursor is anywhere close to most of them.
    var UPDATE_INTERVAL_MS = 45; // ~22 updates/sec cap, down from up to 60/sec
    var NEUTRAL_URI = buildDataUri(0, 0, 0);
    // DOM order of .liquid-smear-feimage matches filter declaration order:
    // the wave first, then the 4 bubbles — each entry's x/y/r approximates
    // that shape's own footprint (bubbles: their cx/cy + a margin; the
    // wave: a generous box covering its typical drift range) used purely
    // to decide whether it's worth updating this frame.
    var targets = [
      { x: 120, y: 420, r: 480 }, // wave
      { x: 470, y: 330, r: 200 }, // bubble 1
      { x: 830, y: 520, r: 200 }, // bubble 2
      { x: 620, y: 800, r: 200 }, // bubble 3
      { x: 500, y: 600, r: 200 } // bubble 4
    ];
    var targetCleared = targets.map(function () {
      return true;
    });

    function buildDataUri(x, y, alpha) {
      var svg =
        '<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="1000">' +
        '<defs><filter id="b" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="30"/></filter></defs>' +
        '<circle cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" r="130" fill="#fff" fill-opacity="' + alpha.toFixed(3) + '" filter="url(#b)"/>' +
        '</svg>';
      return 'data:image/svg+xml;base64,' + btoa(svg);
    }

    function applyFrame() {
      var uri = null;
      for (var i = 0; i < targets.length; i++) {
        var t = targets[i];
        var dx = targetX - t.x;
        var dy = targetY - t.y;
        var inRange = dx * dx + dy * dy <= t.r * t.r;
        if (!inRange) {
          if (!targetCleared[i]) {
            feImages[i].setAttribute('href', NEUTRAL_URI);
            targetCleared[i] = true;
          }
          continue;
        }
        if (uri === null) uri = buildDataUri(targetX, targetY, intensity);
        feImages[i].setAttribute('href', uri);
        targetCleared[i] = false;
      }
    }

    function tick(now) {
      if (now - lastTickTime < UPDATE_INTERVAL_MS) {
        rafId = requestAnimationFrame(tick);
        return;
      }
      lastTickTime = now;
      var elapsed = now - lastMoveTime;
      if (elapsed <= HOLD_MS) {
        intensity = 1;
      } else {
        intensity = Math.max(0, 1 - (elapsed - HOLD_MS) / DECAY_MS);
      }
      applyFrame();
      if (intensity > 0.01) {
        rafId = requestAnimationFrame(tick);
      } else {
        intensity = 0;
        applyFrame();
        rafId = null;
      }
    }

    function handlePointerMove(e) {
      var ctm = svgEl.getScreenCTM();
      if (!ctm) return;
      pt.x = e.clientX;
      pt.y = e.clientY;
      var svgPt = pt.matrixTransform(ctm.inverse());
      targetX = svgPt.x;
      targetY = svgPt.y;
      lastMoveTime = performance.now();
      if (rafId === null) {
        rafId = requestAnimationFrame(tick);
      }
    }

    window.addEventListener('pointermove', handlePointerMove, { passive: true });
  })();
</script>
