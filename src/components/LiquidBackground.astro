---
// Persistent whole-site background layer: a black outer field with an
// organic grey "inner layer" bleeding through, split by a liquid-looking
// boundary. Pure SVG + SMIL/CSS (no JS animation loop) since this sits
// behind every page and animates continuously — a requestAnimationFrame
// loop here would burn a frame budget for a purely decorative layer.
---

<div class="liquid-bg pointer-events-none fixed inset-0 -z-10 overflow-hidden print:hidden" aria-hidden="true">
  <svg class="h-full w-full" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice">
    <defs>
      <filter id="liquid-distort-a" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.014 0.0125" numOctaves="2" seed="7" result="noise">
          <!-- Same fix as the layer drift below: a true sinusoid sampled at
               12 evenly-spaced points, not a handful of hand-picked values.
               Equal time between values here doesn't mean equal PERCEIVED
               change unless the values themselves trace a smooth curve —
               hand-picked ones caused the edge wobble to visibly pause
               and burst even though each segment interpolates linearly. -->
          <animate
            attributeName="baseFrequency"
            dur="34s"
            values="0.0140 0.0125;0.0137 0.0143;0.0128 0.0155;0.0115 0.0160;0.0103 0.0155;0.0093 0.0143;0.0090 0.0125;0.0093 0.0108;0.0103 0.0095;0.0115 0.0090;0.0128 0.0095;0.0137 0.0108;0.0140 0.0125"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="55" xChannelSelector="R" yChannelSelector="G" result="displaced" />
        <!-- Just enough blur to anti-alias the raw turbulence grain (which
             otherwise shows as speckled/jagged pixels right at the edge) —
             far too small to soften the actual wave-scale silhouette. -->
        <feGaussianBlur in="displaced" stdDeviation="2" />
      </filter>
      <filter id="liquid-distort-b" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.019 0.0165" numOctaves="2" seed="23" result="noise">
          <animate
            attributeName="baseFrequency"
            dur="26s"
            values="0.0190 0.0165;0.0185 0.0185;0.0173 0.0200;0.0155 0.0205;0.0138 0.0200;0.0125 0.0185;0.0120 0.0165;0.0125 0.0145;0.0138 0.0130;0.0155 0.0125;0.0173 0.0130;0.0185 0.0145;0.0190 0.0165"
            repeatCount="indefinite"
          />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="42" xChannelSelector="R" yChannelSelector="G" result="displaced" />
        <feGaussianBlur in="displaced" stdDeviation="2" />
      </filter>
      <filter id="liquid-bubble-soft" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="5" />
      </filter>
      <!-- Fully opaque at every stop — only the color shifts, from a lighter
           grey where light would catch a solid blob to a darker grey at the
           rim. That's what reads as a lit, shaded volume without ever
           fading the silhouette itself into fog. -->
      <radialGradient id="liquid-grad-a" cx="34%" cy="38%" r="78%">
        <stop offset="0%" stop-color="var(--color-ink-600)" />
        <stop offset="45%" stop-color="var(--color-ink-700)" />
        <stop offset="100%" stop-color="var(--color-ink-900)" />
      </radialGradient>
      <radialGradient id="liquid-grad-b" cx="38%" cy="34%" r="72%">
        <stop offset="0%" stop-color="#454545" />
        <stop offset="45%" stop-color="var(--color-ink-600)" />
        <stop offset="100%" stop-color="var(--color-ink-800)" />
      </radialGradient>

      <!-- The turbulence/displacement is applied only to a plain white
           silhouette here, used purely as a mask — not to the gradient
           itself. Running the filter on the gradient directly warps its
           internal color rings along with the edge, and a fold in the
           noise field could pinch part of a ring into an isolated dark
           patch mid-shape. Keeping the mask and the gradient in separate
           passes gives a wavy edge with fill shading that stays coherent
           regardless of how the edge bends. -->
      <mask id="liquid-mask-a" maskUnits="userSpaceOnUse" x="-600" y="-600" width="2200" height="2200">
        <g filter="url(#liquid-distort-a)">
          <path
            fill="#fff"
            d="M -100,-100 C 120,-40 260,120 220,320 C 180,510 340,560 320,760 C 305,900 140,970 -100,940 Z"
          ></path>
        </g>
      </mask>
      <mask id="liquid-mask-b" maskUnits="userSpaceOnUse" x="-600" y="-600" width="2200" height="2200">
        <g filter="url(#liquid-distort-b)">
          <path
            fill="#fff"
            d="M -100,60 C 60,10 190,140 170,320 C 150,480 260,540 230,700 C 210,820 90,860 -100,800 Z"
          ></path>
        </g>
      </mask>
    </defs>

    <!-- Back layer: darker grey, larger, slower drift -->
    <g class="liquid-layer liquid-layer-a">
      <rect x="-600" y="-600" width="2200" height="2200" fill="url(#liquid-grad-a)" mask="url(#liquid-mask-a)"></rect>
    </g>

    <!-- Front layer: lighter grey, smaller, faster drift, offset for depth —
         two layers rather than one is what makes the background read as
         genuinely layered/nested rather than a single flat grey shape, per
         the original "make it look layered" request: the darker layer-a
         shows through wherever layer-b's own silhouette doesn't cover it,
         so their two independently-wobbling edges are what create the
         nested "nested coastline" look visible in the screenshots. -->
    <g class="liquid-layer liquid-layer-b">
      <rect x="-600" y="-600" width="2200" height="2200" fill="url(#liquid-grad-b)" mask="url(#liquid-mask-b)"></rect>
    </g>

    <!-- Three dark "bubbles" drifting/pulsing inside the grey area, lava-lamp
         style. Each orbits a small closed loop at constant speed (same
         technique as the two layers above) so none of them ever pause or
         suddenly speed up either. -->
    <g filter="url(#liquid-bubble-soft)">
      <circle class="liquid-bubble liquid-bubble-1" cx="150" cy="300" r="42" fill="var(--color-ink-950)" opacity="0.6"></circle>
      <circle class="liquid-bubble liquid-bubble-2" cx="95" cy="600" r="32" fill="var(--color-ink-950)" opacity="0.7"></circle>
      <circle class="liquid-bubble liquid-bubble-3" cx="180" cy="460" r="36" fill="var(--color-ink-950)" opacity="0.6"></circle>
    </g>
  </svg>
</div>

<script is:inline>
  (function () {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.liquid-bg svg').forEach((svg) => svg.pauseAnimations && svg.pauseAnimations());
  })();
</script>
